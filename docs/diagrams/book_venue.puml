@startuml
actor "Customer" as User
participant UI
participant SVC
database DB

User -> UI : select venue and time
UI -> SVC : bookVenue(venueId, time)
SVC -> DB : queryAvailability(venueId, time)
DB --> SVC : availability status

alt status == available
    SVC -> DB : insertBooking(userId, venueId, time)
    DB --> SVC : booking confirmed
    SVC --> UI : success response
    UI --> User : show booking confirmation
else status == unavailable
    SVC --> UI : error "Time slot already taken"
    UI --> User : show error message
end
@enduml
