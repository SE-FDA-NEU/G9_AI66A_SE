# Copy this file to .env and adjust if needed. Never commit .env.
# Port the web app listens on. macOS users: 5000 is taken by AirPlay - use 5001.
PORT=5000
# Path of the SQLite database file, relative to the repository root.
DATABASE_PATH=data/venues.db
# Any long random string. Used to sign the session cookie.
SECRET_KEY=change-me-to-a-long-random-string
# No email server is configured yet (BR4): the verification link is printed in the terminal
# running the app, and also shown on screen while this is 1. Set it to 0 to hide it.
SHOW_VERIFICATION_LINK=1

# ---------------------------------------------------------------------------
# Vercel / production settings (leave unset for local SQLite + local uploads)
# ---------------------------------------------------------------------------
# Postgres connection string from Vercel Postgres (or any PostgreSQL provider).
# When set, the app uses Postgres instead of SQLite.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
#
# Cloudinary configuration for persistent photo storage on serverless hosting.
# When set, uploaded venue photos are stored in Cloudinary instead of data/uploads/.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Or set the three values separately:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
